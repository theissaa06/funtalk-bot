# ==============================
# FunTalk Bot — конфигурация
# Скопируй в .env и заполни
# ==============================

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=ВАШ_BOT_TOKEN_ЗДЕСЬ

# ID администраторов бота через запятую (не чата, а бота)
# Узнать свой ID: @userinfobot
BOT_ADMIN_IDS=123456789

# Путь к SQLite базе данных
DATABASE_URL=./data/bot.sqlite

# Режим логов: debug | info | error
LOG_LEVEL=info
